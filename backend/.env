DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_SECRET="organizeragend_secret_key_2026_very_long_and_secure"
JWT_REFRESH_SECRET="organizeragend_refresh_secret_2026_different_key"

PORT=3001
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"

# OAuth Google — configure em https://console.cloud.google.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# OAuth Microsoft — configure em https://portal.azure.com
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_CALLBACK_URL=http://localhost:3001/auth/microsoft/callback
